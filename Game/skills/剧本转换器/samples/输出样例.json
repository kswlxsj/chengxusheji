  {
    "id": "E_008",
    "actions": [
      { "type": "dialogue", "text": "你颤抖着望向车厢深处" },
      { "type": "dialogue", "text": "（检定：侦查）" },
      { "type": "dialogue", "text": "在不安的驱使下，你来到五号车厢。" }
