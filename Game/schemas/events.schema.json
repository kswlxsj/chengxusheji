{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "事件列表",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "actions"],
    "properties": {
      "id": { "$ref": "#/$defs/id" },
      "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
      "next": { "$ref": "#/$defs/id" }
    },
    "additionalProperties": false
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "required": ["all"],
          "properties": { "all": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["any"],
          "properties": { "any": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["not"],
          "properties": { "not": { "$ref": "#/$defs/condition" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["flag", "equals"],
          "properties": { "flag": { "$ref": "#/$defs/id" }, "equals": { "type": "boolean" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["hasItem"],
          "properties": { "hasItem": { "$ref": "#/$defs/id" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["objectState"],
          "properties": {
            "objectState": {
              "type": "object",
              "required": ["objectId", "property", "equals"],
              "properties": {
                "objectId": { "$ref": "#/$defs/id" },
                "property": { "type": "string", "minLength": 1 },
                "equals": {}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["attribute", "operator", "value"],
          "properties": {
            "attribute": { "$ref": "#/$defs/id" },
            "operator": { "enum": ["eq", "ne", "lt", "lte", "gt", "gte"] },
            "value": { "type": "integer" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["skill", "equals"],
          "properties": { "skill": { "$ref": "#/$defs/id" }, "equals": { "type": "boolean" } },
          "additionalProperties": false
        }
      ]
    },
    "dialogue": {
      "type": "object",
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "dialogue" },
        "speaker": { "type": "string" },
        "text": { "type": "string" },
        "speed": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "inspect": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "title", "text"],
          "properties": {
            "type": { "const": "inspect" },
            "title": { "type": "string" },
            "text": { "type": "string" },
            "image": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "item"],
          "properties": {
            "type": { "const": "inspect" },
            "item": { "$ref": "#/$defs/id" },
            "title": { "type": "string" },
            "text": { "type": "string" },
            "image": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    },
    "choice": {
      "type": "object",
      "required": ["type", "prompt", "options"],
      "properties": {
        "type": { "const": "choice" },
        "prompt": { "type": "string" },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["label", "next"],
            "properties": {
              "label": { "type": "string" },
              "next": { "$ref": "#/$defs/id" },
              "when": { "$ref": "#/$defs/condition" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "required": ["type", "dice"],
      "properties": {
        "type": { "const": "check" },
        "dice": { "$ref": "#/$defs/id" },
        "outcomes": { "type": "array", "items": { "$ref": "#/$defs/id" } }
      },
      "additionalProperties": false
    },
    "action": {
      "oneOf": [
        { "$ref": "#/$defs/dialogue" },
        { "$ref": "#/$defs/inspect" },
        { "$ref": "#/$defs/choice" },
        { "$ref": "#/$defs/check" },
        {
          "type": "object",
          "required": ["type", "scene"],
          "properties": { "type": { "const": "changeScene" }, "scene": { "$ref": "#/$defs/id" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "key", "value"],
          "properties": { "type": { "const": "setFlag" }, "key": { "$ref": "#/$defs/id" }, "value": {} },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "attribute", "amount"],
          "properties": { "type": { "const": "modifyAttribute" }, "attribute": { "$ref": "#/$defs/id" }, "amount": { "type": "integer" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "skill", "value"],
          "properties": { "type": { "const": "setSkill" }, "skill": { "$ref": "#/$defs/id" }, "value": { "type": "boolean" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "skill"],
          "properties": { "type": { "const": "learnSkill" }, "skill": { "$ref": "#/$defs/id" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "skill"],
          "properties": { "type": { "const": "loseSkill" }, "skill": { "$ref": "#/$defs/id" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "item"],
          "properties": { "type": { "const": "addItem" }, "item": { "$ref": "#/$defs/id" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "object", "patch"],
          "properties": { "type": { "const": "setObjectState" }, "object": { "$ref": "#/$defs/id" }, "patch": { "type": "object" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "name"],
          "properties": { "type": { "const": "custom" }, "name": { "$ref": "#/$defs/id" }, "params": { "type": "object" } },
          "additionalProperties": false
        }
      ]
    }
  }
}
