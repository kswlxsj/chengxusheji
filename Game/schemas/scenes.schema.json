{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "场景列表",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "name", "background", "objects"],
    "properties": {
      "id": { "$ref": "#/$defs/id" },
      "name": { "type": "string", "minLength": 1 },
      "background": { "type": "string", "minLength": 1 },
      "objects": { "type": "array", "items": { "$ref": "#/$defs/object" } }
    },
    "additionalProperties": false
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
    "position": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 100 },
        "y": { "type": "number", "minimum": 0, "maximum": 100 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 }
      },
      "additionalProperties": false
    },
    "condition": {
      "type": "object",
      "oneOf": [
        {
          "required": ["all"],
          "properties": { "all": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } } },
          "additionalProperties": false
        },
        {
          "required": ["any"],
          "properties": { "any": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } } },
          "additionalProperties": false
        },
        {
          "required": ["not"],
          "properties": { "not": { "$ref": "#/$defs/condition" } },
          "additionalProperties": false
        },
        {
          "required": ["flag", "equals"],
          "properties": { "flag": { "$ref": "#/$defs/id" }, "equals": { "type": "boolean" } },
          "additionalProperties": false
        },
        {
          "required": ["hasItem"],
          "properties": { "hasItem": { "$ref": "#/$defs/id" } },
          "additionalProperties": false
        },
        {
          "required": ["attribute", "operator", "value"],
          "properties": {
            "attribute": { "$ref": "#/$defs/id" },
            "operator": { "enum": ["eq", "ne", "lt", "lte", "gt", "gte"] },
            "value": { "type": "integer" }
          },
          "additionalProperties": false
        },
        {
          "required": ["skill", "equals"],
          "properties": { "skill": { "$ref": "#/$defs/id" }, "equals": { "type": "boolean" } },
          "additionalProperties": false
        },
        {
          "required": ["objectState"],
          "properties": {
            "objectState": {
              "type": "object",
              "required": ["objectId", "property", "equals"],
              "properties": {
                "objectId": { "$ref": "#/$defs/id" },
                "property": { "type": "string", "minLength": 1 },
                "equals": {}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "object": {
      "type": "object",
      "required": ["id", "name", "image", "position", "clickEvent"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "image": { "type": "string", "minLength": 1 },
        "position": { "$ref": "#/$defs/position" },
        "zIndex": { "type": "integer" },
        "clickEvent": { "$ref": "#/$defs/id" },
        "visibleWhen": { "$ref": "#/$defs/condition" },
        "fullCanvas": {
          "type": "boolean",
          "default": false,
          "description": "整幅画布贴图：该图与场景背景同尺寸画布、四周带透明边（透明边含位置信息）。渲染时与背景共用同一画布→屏幕映射整幅叠放；position 固定为 {x:0,y:0,width:100,height:100}，点击与悬停由运行时不透明像素判定。"
        }
      },
      "additionalProperties": false
    }
  }
}
